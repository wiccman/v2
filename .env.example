MODE=live
KALSHI_ENV=production
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_B64=
TRADING_ENABLED=false
# Opt-in MM execution replaces legacy entries/exits for the running process.
EXECUTION_STRATEGY=strike_ruler
MM_BUDGET_DOLLARS=10
MM_QUOTE_CONTRACTS=1
MM_LEVELS_PER_SIDE=5
MM_LEVEL_STEP_CENTS=1
MM_SPREAD_CENTS=8
MM_FEE_RESERVE_CENTS=2
MM_QUOTE_TTL_SECONDS=15
MM_POLL_SECONDS=3
MM_MAX_DATA_AGE_SECONDS=5
MM_STOP_BEFORE_CLOSE_SECONDS=60
MM_MAX_MID_MOVE_CENTS=10
MM_COOLDOWN_SECONDS=30
# Shared per-15-minute-market cap, including an entry fee cushion; hard maximum 5.
MARKET_BUDGET_DOLLARS=5
# Entry limit:exit target pairs in outcome cents, for every Strike Ruler route.
ENTRY_EXIT_PAIRS_CENTS=25:31,39:46
# Independent exit monitor. Entry lookups and POLL_SECONDS do not delay it.
EXIT_POLL_SECONDS=1
# Desired principal per trigger/side, split equally between both entry levels.
# Both share the remaining market allowance; this is not a budget per tier.
ENTRY_BUDGET_DOLLARS=0.77
MAX_PURCHASES_PER_MARKET=7
ENTRY_INTERVAL_SECONDS=7
ENTRY_START_MINUTE=2
ENTRY_END_MINUTE=5
# New buys stop by 5:00; Strike Ruler entry orders expire at 6:00 (fixed).
PREDICTION_UPDATE_MINUTES=2,4,6
SPOT_ENTRY_WINDOW_MINUTES=2
SPOT_ENTRY_THRESHOLD_DOLLARS=80
FINAL_ENTRY_START_MINUTE=12
FINAL_ENTRY_END_MINUTE=15
FINAL_CONFIDENCE_MIN_PERCENT=65
TAKE_PROFIT_RETRY_SECONDS=60
DUAL_LIMIT_BUYS_ENABLED=true
HISTORICAL_STRIKE_ENABLED=true
HISTORICAL_STRIKE_COUNT=3
HISTORICAL_STRIKE_TOUCH_DOLLARS=25
ABSOLUTE_GAP_AVERAGE=59.58
POLL_SECONDS=7
STATE_PATH=/data/state.json
LOG_PATH=/data/trades.csv
