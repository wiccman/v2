MODE=live
KALSHI_ENV=production
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_B64=
TRADING_ENABLED=false
EXECUTION_STRATEGY=strike_ruler
# Shared per-15-minute-market cap is fixed at $20, including entry fee reserves.
# Legacy MARKET_BUDGET_DOLLARS is ignored.
# Entry limit:exit target pairs in outcome cents, for every Strike Ruler route.
ENTRY_EXIT_PAIRS_CENTS=49:59,55:62,56:61,61:70
# First two minutes: live strike side at 52c->60c and independent fixed 57c->62c.
# The 57c quote must be exact; its two-minute cutoff is fixed in code.
OPENING_BIAS_ENABLED=true
OPENING_BIAS_PAIR_CENTS=52:60
OPENING_WINDOW_MINUTES=2
# Independent exit monitor. Entry lookups and POLL_SECONDS do not delay it.
EXIT_POLL_SECONDS=1
# Earlier entry orders request 5 contracts; partial exchange fills remain possible.
# Reserve $6 for one 6-contract 97c IOC in minutes 12-15, held to settlement.
# Earlier entries share $14; total cap stays $20.
# Legacy ENTRY_BUDGET_DOLLARS is ignored. All routes share the $20 allowance.
MAX_PURCHASES_PER_MARKET=7
ENTRY_INTERVAL_SECONDS=7
ENTRY_START_MINUTE=0
ENTRY_END_MINUTE=12
# Ordinary under-70c entries stop at 6:00; 35c buys are retired.
# Exact 75c->83c from 6:00; 70c->76c from 8:00; 73c->79c / 85c->91c from 11:00.
# Scalp entries end at 12:00; settlement owns the final three minutes.
# ENTRY_START_MINUTE / ENTRY_END_MINUTE are informational; old overrides are ignored.
SPOT_ENTRY_WINDOW_MINUTES=2
SPOT_ENTRY_THRESHOLD_DOLLARS=80
DUAL_LIMIT_BUYS_ENABLED=true
HISTORICAL_STRIKE_ENABLED=true
HISTORICAL_STRIKE_COUNT=3
HISTORICAL_STRIKE_TOUCH_DOLLARS=25
ABSOLUTE_GAP_AVERAGE=59.58
POLL_SECONDS=5
STATE_PATH=/data/state.json
LOG_PATH=/data/trades.csv


