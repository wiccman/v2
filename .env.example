# Manual exits only. Default startup is read-only; see MANUAL_FIVE_CENT_EXITS.md.
KALSHI_ENV=production
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_B64=

# The old automatic-entry strategy must remain disabled.
TRADING_ENABLED=false
STATE_PATH=/data/state.json
AUTOMATIC_EXIT_STATE_PATH=/data/state_take_profit.json

MANUAL_EXITS_ENABLED=false
MANUAL_EXITS_DRY_RUN=true
# The API cannot prove human origin; no other writer may create managed orders.
MANUAL_EXTERNAL_ORDERS_ARE_MANUAL=false
MANUAL_EXIT_MODE=resting_limit
# Resting orders are not exchange-protected reduce-only. Cancel the bot's sell
# before manually closing the same position. The worker manages only its exits.
# Per contract, above each manual fill price, before fees.
MANUAL_EXIT_INCREMENT_CENTS=5
MANUAL_EXIT_SERIES=KXBTC15M,KXETH15M
MANUAL_EXIT_POLL_SECONDS=1
# Preview and live use separate journals derived from STATE_PATH by default.
