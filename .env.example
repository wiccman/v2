MODE=live
KALSHI_ENV=production
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_B64=
TRADING_ENABLED=false
EXECUTION_STRATEGY=strike_ruler
# $14 earlier-entry exposure plus $6 protected settlement reserve per market.
# All entries share the market cap; sales do not replenish spent allowance.
MARKET_BUDGET_DOLLARS=20
# Gross profit goal per buy order across all its contracts, before fees.
PER_ORDER_PROFIT_DOLLARS=0.20
# Legacy paired exits remain for older inventory and above-99c fallbacks.
ENTRY_EXIT_PAIRS_CENTS=49:59,55:62,56:61,61:70
# From 0:00 to 2:00: opposite live strike side at 52c->60c and fixed 57c->62c.
# The 57c quote must be exact; its two-minute cutoff is fixed in code.
OPENING_BIAS_ENABLED=true
OPENING_BIAS_PAIR_CENTS=52:60
OPENING_WINDOW_MINUTES=2
# Independent exit monitor. Entry lookups and POLL_SECONDS do not delay it.
EXIT_POLL_SECONDS=1
# Earlier orders use up to $2.80 including fees, with at most 5 whole contracts.
# All earlier trades share $14 of the market allowance.
# Reserve $6 for a 6-contract 96c GTC in minutes 12-15, held to settlement.
# The 96c limit triggers at an ask >=96c and expires at close; it uses the $6 reserve.
# Legacy ENTRY_BUDGET_DOLLARS is ignored. All routes share the $20 allowance.
# Counts committed regular orders; proven zero-fill attempts do not consume it.
MAX_PURCHASES_PER_MARKET=15
ENTRY_INTERVAL_SECONDS=7
ENTRY_START_MINUTE=0
ENTRY_END_MINUTE=12
# Ordinary under-70c entries stop at 6:00; 35c buys are retired.
# Early buys are eligible at contract open; there is no one-minute delay.
# Buy limits of 60c or higher cannot submit before 5:00 on any route.
# 75c GTC->83c from 6:00 at ask>=75c; 70c->76c from 8:00.
# 73c->79c / 85c->91c from 11:00; these and other earlier entries use IOC.
# Scalp entries end at 12:00; settlement owns the final three minutes.
# ENTRY_START_MINUTE / ENTRY_END_MINUTE are informational; old overrides are ignored.
SPOT_ENTRY_WINDOW_MINUTES=2
SPOT_ENTRY_THRESHOLD_DOLLARS=80
DUAL_LIMIT_BUYS_ENABLED=true
HISTORICAL_STRIKE_ENABLED=true
HISTORICAL_STRIKE_COUNT=3
HISTORICAL_STRIKE_TOUCH_DOLLARS=25
ABSOLUTE_GAP_AVERAGE=59.58
POLL_SECONDS=5
STATE_PATH=/data/state.json
LOG_PATH=/data/trades.csv
