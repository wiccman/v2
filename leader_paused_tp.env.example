# INACTIVE TEMPLATE: this file is not loaded by the bot.
# Deploy this branch yourself before applying these settings.
LEADER_TRADING_ENABLED=false
LEADER_EXITS_ENABLED=true
LEADER_TAKE_PROFIT_CENTS=7
ZONE_BUYING_ENABLED=false

# Applies only to verified positions bought by the Crypto Leader runner.
# Manual positions and outside activity on the same ticker are not adopted.
# TP = verified average entry + 7 cents, rounded up to a full cent.
# Example: 72-cent entry -> 79-cent reduce-only resting sell.
# Targets above 99 cents are skipped; they are not reduced to 99 cents.
# No stop loss or forced minute-14 exit is added.
# Existing/canceled TP orders are not repriced or replaced.
